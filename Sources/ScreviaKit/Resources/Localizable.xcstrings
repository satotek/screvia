    "annotation.crop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crop"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリミング"
          }
        }
      }
    },
    "annotation.crop.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag over the part to keep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残したい範囲をドラッグします。"
          }
        }
      }
    },
    "annotation.cropHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to choose the area to keep. ⌘Z undoes the crop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残す範囲をドラッグで選びます。⌘Z で元に戻せます。"
          }
        }
      }
    },
    "annotation.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "annotation.deleteAll": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete All"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて削除"
          }
        }
      }
    },
    "annotation.duplicate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複製"
          }
        }
      }
    },
    "annotation.editorTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screvia — Edit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Screvia — 編集"
          }
        }
      }
    },
    "annotation.ellipse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellipse"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "楕円"
          }
        }
      }
    },
    "annotation.ellipse.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to draw an ellipse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで楕円を描きます。"
          }
        }
      }
    },
    "annotation.eyedropperHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyedropper: click a point, or drag over an area for its average colour. It becomes the drawing colour and is copied."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スポイト：点をクリックするか、範囲をドラッグして平均の色を取ります。その色で描けるようになり、コピーもされます。"
          }
        }
      }
    },
    "annotation.freehand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freehand"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フリーハンド"
          }
        }
      }
    },
    "annotation.freehand.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to draw freely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグしたとおりに線を描きます。"
          }
        }
      }
    },
    "annotation.highlight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライト"
          }
        }
      }
    },
    "annotation.highlight.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag over text to highlight it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の上をドラッグして、蛍光ペンを引きます。"
          }
        }
      }
    },
    "annotation.line": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直線"
          }
        }
      }
    },
    "annotation.line.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to draw a straight line. Drag the handle in the middle to bend it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで直線を引きます。真ん中のハンドルをドラッグすると曲げられます。"
          }
        }
      }
    },
    "annotation.liveText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを選択"
          }
        }
      }
    },
    "annotation.liveText.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select text in the image, to copy it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の中の文字を選んで、コピーできます。"
          }
        }
      }
    },
    "annotation.liveTextHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag across text to select it, then press ⌘C or right-click to copy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字をドラッグして選び、⌘C か右クリックでコピーします。"
          }
        }
      }
    },
    "annotation.magnifier": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnifier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大鏡"
          }
        }
      }
    },
    "annotation.magnifier.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to enlarge what is under it. ⌥-drag it to enlarge somewhere else."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグした場所を拡大します。⌥ を押しながらドラッグすると、拡大する場所を動かせます。"
          }
        }
      }
    },
    "annotation.magnifierHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥-drag to choose what it enlarges"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ を押しながらドラッグすると、拡大する場所を動かせます"
          }
        }
      }
    },
    "annotation.more": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他"
          }
        }
      }
    },
    "annotation.outputSizeHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The size Save writes, after cropping and before effects"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存される画像のサイズです（切り抜き後、エフェクトを付ける前）"
          }
        }
      }
    },
    "annotation.pixelate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pixelate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モザイク"
          }
        }
      }
    },
    "annotation.pixelate.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag over what to hide, to pixelate it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隠したいところをドラッグして、モザイクをかけます。"
          }
        }
      }
    },
    "annotation.rectangle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rectangle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矩形"
          }
        }
      }
    },
    "annotation.rectangle.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to draw a rectangle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで四角形を描きます。"
          }
        }
      }
    },
    "annotation.saveReplacesHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を上書きします"
          }
        }
      }
    },
    "annotation.select": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択"
          }
        }
      }
    },
    "annotation.select.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select, move and resize annotations. Any tool moves an annotation dragged from it, and a click on empty space comes back here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注釈を選んで、移動やサイズ変更をします。どのツールでも図形をドラッグすれば動かせて、何もない場所をクリックするとこのツールに戻ります。"
          }
        }
      }
    },
    "annotation.sizePoints": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d × %d pt"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d × %d pt"
          }
