    "permission.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screvia needs Screen Recording permission to capture your screen. macOS asks only once; after that, the permission is turned on in System Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を撮影するには、画面収録の権限が必要です。macOS が確認するのは最初の 1 回だけで、それ以降はシステム設定でオンにします。"
          }
        }
      }
    },
