{
  "sourceLanguage": "en",
  "strings": {
    "about.menuTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Screvia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Screvia について"
          }
        }
      }
    },
    "about.versionFormat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %@ (%@)"
          }
        }
      }
    },
    "annotation.arrow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印"
          }
        }
      }
    },
    "annotation.arrow.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag from where the arrow starts to what it points at. Drag the handle in the middle to bend it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印の根元から、指したい場所までドラッグします。真ん中のハンドルをドラッグすると曲げられます。"
          }
        }
      }
    },
    "annotation.balloon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech Balloon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "吹き出し"
          }
        }
      }
    },
    "annotation.balloon.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag from what it points at to where the balloon goes, then type."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指したい場所から吹き出しを置く場所までドラッグし、文字を入力します。"
          }
        }
      }
    },
    "annotation.blur": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぼかし"
          }
        }
      }
    },
    "annotation.blur.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag over what to hide, to blur it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隠したいところをドラッグして、ぼかします。"
          }
        }
      }
    },
    "annotation.colorFormat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colour Format"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カラーコードの形式"
          }
        }
      }
    },
    "annotation.copyColorHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The colour under the pointer. Tab copies it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルの下の色です。Tab でコピーします。"
          }
        }
      }
    },
    "annotation.copyText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストをコピー"
          }
        }
      }
    },
    "annotation.copyTextHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the text in the image"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の中の文字をコピー"
          }
        }
      }
    },
