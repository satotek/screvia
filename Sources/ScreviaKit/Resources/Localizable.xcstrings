    "error.accessibilityPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility access is required for scrolling capture. Allow Screvia in System Settings → Privacy & Security → Accessibility."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロール撮影にはアクセシビリティの権限が必要です。システム設定の「プライバシーとセキュリティ」から Screvia を許可してください。"
          }
        }
      }
    },
    "error.cropFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected area could not be cropped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択範囲を画像として切り出せませんでした。"
          }
        }
      }
    },
    "error.desktopFolderUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The save location could not be found."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存先フォルダを取得できませんでした。"
          }
        }
      }
    },
    "error.displayImageUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display image could not be captured."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイの画像を取得できませんでした。"
          }
        }
      }
    },
    "error.imageEncodingFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image could not be converted to the selected format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を指定形式に変換できませんでした。"
          }
        }
      }
    },
    "error.noScreen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No display is available to capture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャ対象のディスプレイが見つかりませんでした。"
          }
        }
      }
    },
    "error.screenRecordingPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording permission is required. Allow Screvia in System Settings, then restart it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録の権限が必要です。システム設定で Screvia を許可してから、再起動してください。"
          }
        }
      }
    },
    "error.scrollCaptureFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolling capture could not create an input event."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロール撮影用の入力イベントを作成できませんでした。"
          }
        }
      }
    },
    "error.scrollCaptureTargetUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected window cannot be used for scrolling capture."
          }
        },
        "ja": {
