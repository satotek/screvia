    },
    "annotation.step": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ"
          }
        }
      }
    },
    "annotation.step.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to place ①②③ in order. Deleting one renumbers the rest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックで ①②③ と順に番号を置きます。消すと番号が詰まります。"
          }
        }
      }
    },
    "annotation.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト"
          }
        }
      }
    },
    "annotation.text.usage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click where the text goes, then type. Double-click text to change it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックした場所に文字を入力します。文字はダブルクリックで直せます。"
